{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volunteer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  // 線上曾出現 error 1101（Worker threw exception）且無法穩定重現；
  // 開啟 observability 後，例外堆疊會留存於 Cloudflare Dashboard → Workers → volunteer → Logs。
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // staging：PR 預覽用，部署為獨立的 worker（volunteer-staging），指向 staging
  // Supabase 專案。secrets（SUPABASE_SERVICE_ROLE_KEY 等）需另以
  //   npx wrangler secret put <NAME> --env staging
  // 設定一次。詳見 .github/workflows/preview.yml 的說明。
  "env": {
    "staging": {
      "name": "volunteer-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }
}
