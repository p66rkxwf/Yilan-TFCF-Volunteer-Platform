{
    "name": "yilan-tfcf-volunteer-platform",
    "version": "1.0.0",
    "description": "宜蘭家扶志工管理與報名平台。",
    "main": "index.js",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:db": "vitest run tests/db",
        "db:apply": "node scripts/apply-v2-sql.mjs",
        "check:registry": "node scripts/check-function-registry.mjs",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/p66rkxwf/yilan-TFCF-volunteer-platform.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/p66rkxwf/yilan-TFCF-volunteer-platform/issues"
    },
    "homepage": "https://github.com/p66rkxwf/yilan-TFCF-volunteer-platform#readme",
    "dependencies": {
        "@opennextjs/cloudflare": "^1.20.2",
        "@supabase/ssr": "^0.12.4",
        "@supabase/supabase-js": "^2.98.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^25.2.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "next": "^16.1.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "server-only": "^0.0.1",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.1.6",
        "pg": "^8.13.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "vitest": "^3.2.4",
        "wrangler": "^4.105.0"
    }
}
